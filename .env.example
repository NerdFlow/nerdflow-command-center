# Supabase. Dashboard -> Connect -> ORMs -> Prisma.
# The app (DATABASE_URL) uses the transaction pooler, port 6543.
# Migrations (DIRECT_URL) need a session connection. On a VPS without IPv6,
# use the pooler's session string (port 5432 on *.pooler.supabase.com), not
# the direct db.[ref].supabase.co host, which is often IPv6-only.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=nerdflow.tech
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me-32-bytes-minimum

# AI provider: gemini or anthropic. If unset, Gemini is used when
# GEMINI_API_KEY is set, otherwise Claude when ANTHROPIC_API_KEY is set.
# With neither key, every AI feature uses its rule-based fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=gemini-3.6-flash
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_DEEP=gemini-3.6-flash
AI_MONTHLY_BUDGET_USD=150

# Optional Supabase API keys. Prisma does not use these; the connection
# strings above are what the app needs. Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Everything below is Phase 2+ (lead engine, calls, Gmail sync). Not used yet.
GOOGLE_PLACES_API_KEY=
APOLLO_API_KEY=
EMAIL_VERIFIER_API_KEY=
OPENCLAW_INGEST_TOKEN=
LEAD_ENGINE_DAILY_CAP_DEFAULT=30
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_API_KEY=
CALLING_APP_WEBHOOK_SECRET=
CALLING_APP_API_KEY=
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=
TOKEN_ENCRYPTION_KEY=
