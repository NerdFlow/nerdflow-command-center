# ── Local dev defaults (works with `docker compose up -d`, no other setup) ──
DATABASE_URL="postgresql://flow:flow@localhost:5432/flow_command_center"
DIRECT_URL="postgresql://flow:flow@localhost:5432/flow_command_center"

# ── If you point this at Supabase instead of local Postgres ──
# Use the pooled connection (port 6543, pgbouncer=true) for DATABASE_URL and
# the direct connection (port 5432) for DIRECT_URL (Prisma Migrate needs a
# direct connection). Get both from Project Settings -> Database.
# Set connection_limit based on how many concurrent requests this server
# actually handles — connection_limit=1 (Supabase's own snippet) is meant for
# one-connection-per-invocation serverless functions, NOT a long-running
# Next.js server; leaving it at 1 here causes constant "timed out fetching a
# connection from the pool" errors under any concurrent load.
# DATABASE_URL="postgresql://postgres:[password]@db.[project].supabase.co:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=nerdflow.tech
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me-32-bytes-minimum

# Dev login (no external accounts needed): shows a "pick a seeded user" screen
# on /login instead of Google sign-in. Turn off once Google OAuth is wired up.
ALLOW_DEV_LOGIN=true

# ── Real integrations: leave blank locally, fill in when you have them ──
# Once GOOGLE_CLIENT_ID/SECRET are set, /login switches to real Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Once ANTHROPIC_API_KEY is set, AI features (brief, strategy, rewrite, chat,
# reply classification, close-out summary) call the real Claude API. Until
# then every AI feature runs its rule-based fallback — the app is fully
# usable without this key.
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_DEEP=claude-opus-5
AI_MONTHLY_BUDGET_USD=150

# Supabase (production target — swap DATABASE_URL to Supabase's connection
# string and add these when you migrate off local Postgres; also apply the
# RLS policies described in README.md "Going to production").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DIRECT_URL=

# Everything below is Phase 2+ (lead engine, calls, Gmail sync). Not used yet.
GOOGLE_PLACES_API_KEY=
APOLLO_API_KEY=
EMAIL_VERIFIER_API_KEY=
OPENCLAW_INGEST_TOKEN=
LEAD_ENGINE_DAILY_CAP_DEFAULT=30
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_API_KEY=
CALLING_APP_WEBHOOK_SECRET=
CALLING_APP_API_KEY=
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=
TOKEN_ENCRYPTION_KEY=
