// FLOW Sales Command Center — data model per docs/SPEC.md section 4.
// Phase 1 implements every table; Phase 2+ tables (reviews, conversations,
// integrations, ai_usage, etc.) exist now so later phases don't need
// migrations that touch already-shipped screens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  rep
  lead
}

enum UserStatus {
  invited
  active
  deactivated
}

enum TargetMetric {
  leads_verified
  emails
  calls
  instagram_dms
  linkedin_messages
}

enum ProductType {
  product
  service
}

enum ProductStatus {
  active
  archived
}

enum KnowledgeSource {
  upload
  paste
  url
  auto_learning
}

enum CampaignStatus {
  draft
  active
  paused
  archived
}

enum CampaignNoteKind {
  note
  system
  learning
}

enum LeadSource {
  google_places
  open_data
  apollo
  openclaw
  csv
  manual
  portfolio_agent
  ai_search
}

enum LeadStatus {
  inbox
  rejected
  queued
  in_cadence
  replied
  deal
  not_fit
  finished
  do_not_contact
}

enum EmailVerification {
  unknown
  valid
  risky
  invalid
}

enum Channel {
  email
  call
  instagram
  linkedin
}

enum TouchOutcome {
  sent
  no_answer
  talked_not_now
  replied
  interested
  not_fit
}

enum DealStage {
  interested
  discovery
  demo
  proposal
  closing
  won
  lost
}

enum LostReason {
  price
  timing
  no_decision
  competitor
  not_fit
  went_silent
  other
}

enum ConversationKind {
  email_out
  email_in
  call
  meeting
  dm_in
  dm_out
  note
  voice_debrief
  practice
}

enum ConversationSource {
  manual
  gmail
  calling_app
  meet_transcript
  voice_note
}

enum ReviewStatus {
  none
  queued
  done
  failed
}

enum RepFeedback {
  helpful
  wrong
}

enum CoachingRuleStatus {
  active
  kept
  dropped
}

enum IntegrationProvider {
  google
  gmail
  calling_app
  slack
  openclaw
}

enum AiFeature {
  brief
  review
  strategy
  scoring
  chat
  roleplay
  draft_review
  prep
  weekly_patterns
  reply_classification
  close_out_summary
  lead_discovery
}

enum NotificationChannel {
  in_app
  slack
}

enum ReplyLabel {
  interested
  question
  objection
  not_now
}

enum ReplyStatus {
  open
  handled
  snoozed
}

enum ObjectionResponseStatus {
  new
  testing
  proven
  retired
}

// ───────────────────────────── Core ─────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  targets       Target[]
  dailyStats    DailyStat[]
  products      Product[]
  knowledgeDocs KnowledgeDoc[]
  campaigns     Campaign[]
  leads         Lead[]
  deals         Deal[]
  conversations Conversation[]
  coachingRules CoachingRule[]
  chatThreads   ChatThread[]
  integrations  Integration[]
  aiUsage       AiUsage[]
  auditLogs     AuditLog[]
  notifications Notification[]
  settings      OrgSettings?

  @@map("organizations")
}

model OrgSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allowedEmailDomain   String   @map("allowed_email_domain")
  assistantName        String   @default("Flow") @map("assistant_name")
  leadDailyCapDefault  Int      @default(30) @map("lead_daily_cap_default")
  aiMonthlyBudgetUsd   Int      @default(150) @map("ai_monthly_budget_usd")
  workingHoursDefault  Json     @default("{\"start\":\"09:00\",\"end\":\"17:30\",\"days\":[1,2,3,4,5]}") @map("working_hours_default")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("org_settings")
}

model User {
  id                     String     @id @default(uuid())
  organizationId         String     @map("organization_id")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                  String     @unique
  passwordHash           String?    @map("password_hash")
  fullName               String     @map("full_name")
  role                   Role       @default(rep)
  status                 UserStatus @default(invited)
  timezone               String     @default("Asia/Karachi")
  workingHours           Json       @default("{\"start\":\"09:00\",\"end\":\"17:30\",\"days\":[1,2,3,4,5]}") @map("working_hours")
  profileCompletedAt     DateTime?  @map("profile_completed_at")
  photoUrl               String?    @map("photo_url") @db.VarChar(2048)
  channelAccounts        Json       @default("{}") @map("channel_accounts")
  channelsWorked         Json       @default("[\"call\",\"email\"]") @map("channels_worked")
  lastLoginAt            DateTime?  @map("last_login_at")
  sessionsInvalidatedAt  DateTime?  @map("sessions_invalidated_at")
  isDemo                 Boolean    @default(false) @map("is_demo")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  targetsOwned      Target[]        @relation("TargetUser")
  targetsSet        Target[]        @relation("TargetSetBy")
  dailyStats        DailyStat[]
  knowledgeUploads  KnowledgeDoc[]
  campaignsOwned    Campaign[]      @relation("CampaignOwner")
  campaignsApproved Campaign[]      @relation("CampaignApprovedBy")
  campaignNotes     CampaignNote[]
  leadsOwned        Lead[]          @relation("LeadOwner")
  leadsApproved     Lead[]          @relation("LeadApprovedBy")
  touches           Touch[]
  dealsOwned        Deal[]          @relation("DealOwner")
  reviewFeedback    Review[]        @relation("ReviewFeedbackBy")
  coachingRules     CoachingRule[]
  chatThreads       ChatThread[]
  integrations      Integration[]
  aiUsage           AiUsage[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  researchApproved  Research[]      @relation("ResearchApprovedBy")
  sessions          FocusSession[]

  @@map("users")
}

model Target {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  metric         TargetMetric
  dailyValue     Int          @map("daily_value")
  effectiveFrom  DateTime     @map("effective_from") @db.Date
  setById        String       @map("set_by")
  setBy          User         @relation("TargetSetBy", fields: [setById], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([userId, metric, effectiveFrom])
  @@map("targets")
}

model DailyStat {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  counts         Json         @default("{}")
  replies        Int          @default(0)
  meetingsBooked Int          @default(0) @map("meetings_booked")
  targetPct      Int?         @map("target_pct")
  closedOutAt    DateTime?    @map("closed_out_at")
  blocker        String?      @db.Text
  learning       String?      @db.Text
  aiSummary      String?      @map("ai_summary") @db.Text
  streakAfter    Int?         @map("streak_after")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("daily_stats")
}

model Product {
  id                  String        @id @default(uuid())
  organizationId      String        @map("organization_id")
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  type                ProductType
  summary              String        @db.Text
  logoUrl             String?       @map("logo_url") @db.VarChar(2048)
  website             String?       @db.VarChar(2048)
  audience            String?       @db.Text @map("audience")
  decisionMakerTitles Json          @default("[]") @map("decision_maker_titles")
  features            Json          @default("[]")
  pricing             Json          @default("{}")
  caseStudies         Json          @default("[]") @map("case_studies")
  competitors         Json          @default("[]")
  donts               Json          @default("[]")
  status              ProductStatus @default(active)
  isDemo              Boolean       @default(false) @map("is_demo")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  knowledgeDocs KnowledgeDoc[]
  campaigns     Campaign[]
  deals         Deal[]

  @@map("products")
}

model KnowledgeDoc {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String?         @map("product_id")
  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaignId     String?         @map("campaign_id")
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  source         KnowledgeSource
  storagePath    String?         @map("storage_path") @db.Text
  extractedText  String          @map("extracted_text") @db.Text
  tokenEstimate  Int             @default(0) @map("token_estimate")
  uploadedById   String          @map("uploaded_by")
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("knowledge_docs")
}

model Campaign {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id])
  name             String
  ownerId          String         @map("owner_id")
  owner            User           @relation("CampaignOwner", fields: [ownerId], references: [id])
  status           CampaignStatus @default(draft)
  goal             String?        @db.Text
  location         String?
  strategy         Json           @default("{}")
  strategyVersion  Int            @default(1) @map("strategy_version")
  leadDailyCap     Int            @default(30) @map("lead_daily_cap")
  approvedById     String?        @map("approved_by")
  approvedBy       User?          @relation("CampaignApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?      @map("approved_at")
  pausedReason     String?        @map("paused_reason") @db.Text
  isDemo           Boolean        @default(false) @map("is_demo")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  notes             CampaignNote[]
  sourceRuns        LeadSourceRun[]
  leads             Lead[]
  deals             Deal[]
  knowledgeDocs     KnowledgeDoc[]
  research          Research?
  icps              Icp[]
  objectionResponses ObjectionResponse[]

  @@map("campaigns")
}

model CampaignNote {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  campaignId     String           @map("campaign_id")
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorId       String?          @map("author_id")
  author         User?            @relation(fields: [authorId], references: [id])
  kind           CampaignNoteKind @default(note)
  body           String           @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("campaign_notes")
}

model Research {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campaignId     String    @unique @map("campaign_id")
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  marketSnapshot String?   @map("market_snapshot") @db.Text
  buyers         Json      @default("[]")
  painPoints     Json      @default("[]") @map("pain_points")
  competitors    Json      @default("[]")
  channels       Json      @default("[]")
  angles         Json      @default("[]")
  sources        Json      @default("[]")
  approvedById   String?   @map("approved_by")
  approvedBy     User?     @relation("ResearchApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("research")
}

model Icp {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  campaignId        String   @map("campaign_id")
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  businessTypes     Json     @default("[]") @map("business_types")
  keywords          Json     @default("[]")
  sizeSignals       String?  @map("size_signals") @db.Text
  mustHave          Json     @default("[]") @map("must_have")
  niceToHave        Json     @default("[]") @map("nice_to_have")
  disqualifiers     Json     @default("[]")
  decisionMakerTitles Json   @default("[]") @map("decision_maker_titles")
  weights           Json     @default("{}")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  runs LeadSourceRun[]

  @@map("icps")
}

enum LeadSourceRunStatus {
  running
  paused
  completed
  failed
}

enum LeadSourceRunSchedule {
  once
  daily
  weekly
}

model LeadSourceRun {
  id                  String                 @id @default(uuid())
  organizationId      String                 @map("organization_id")
  campaignId          String                 @map("campaign_id")
  campaign            Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  icpId               String?                @map("icp_id")
  icp                 Icp?                   @relation(fields: [icpId], references: [id])
  source              LeadSource
  status              LeadSourceRunStatus    @default(running)
  locations           Json                   @default("[]")
  keywords            Json                   @default("[]")
  maxLeads            Int                    @default(100) @map("max_leads")
  minFitScore         Int                    @default(50) @map("min_fit_score")
  autoApproveAbove    Int?                   @map("auto_approve_above")
  schedule            LeadSourceRunSchedule  @default(once)
  currentLocation     String?                @map("current_location") @db.Text
  currentKeyword      String?                @map("current_keyword") @db.Text
  narration           String?                @db.Text
  startedAt           DateTime               @map("started_at")
  finishedAt          DateTime?              @map("finished_at")
  found               Int                    @default(0)
  enriched            Int                    @default(0)
  matchedIcp          Int                    @default(0) @map("matched_icp")
  new                 Int                    @default(0)
  duplicates          Int                    @default(0)
  rejectedAuto        Int                    @default(0) @map("rejected_auto")
  error               String?                @db.Text
  costUsd             Decimal                @default(0) @map("cost_usd") @db.Decimal(10, 2)

  leads Lead[]

  @@map("lead_sources_runs")
}

model Lead {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId         String             @map("campaign_id")
  campaign           Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ownerId            String             @map("owner_id")
  owner              User               @relation("LeadOwner", fields: [ownerId], references: [id])
  status             LeadStatus         @default(inbox)
  businessName       String             @map("business_name")
  contactName        String?            @map("contact_name")
  contactRole        String?            @map("contact_role")
  city               String?
  region             String?
  country            String?
  website            String?            @db.VarChar(2048)
  phone              String?
  email              String?
  instagramUrl       String?            @map("instagram_url") @db.VarChar(2048)
  linkedinUrl        String?            @map("linkedin_url") @db.VarChar(2048)
  emailVerification  EmailVerification  @default(unknown) @map("email_verification")
  signals            Json               @default("{}")
  source             LeadSource
  sourceUrl          String?            @map("source_url") @db.VarChar(2048)
  sourceRunId        String?            @map("source_run_id")
  sourceRun          LeadSourceRun?     @relation(fields: [sourceRunId], references: [id])
  fitScore           Int                @default(0) @map("fit_score")
  fitReasons         Json               @default("[]") @map("fit_reasons")
  fitFlags           Json               @default("[]") @map("fit_flags")
  dedupeKey          String             @map("dedupe_key")
  cadenceStep        Int                @default(0) @map("cadence_step")
  nextTouchAt        DateTime?          @map("next_touch_at")
  approvedById       String?            @map("approved_by")
  approvedBy         User?              @relation("LeadApprovedBy", fields: [approvedById], references: [id])
  rejectedReason     String?            @map("rejected_reason") @db.Text
  isDemo             Boolean            @default(false) @map("is_demo")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  touches       Touch[]
  deals         Deal[]
  conversations Conversation[]
  replies       Reply[]

  @@index([dedupeKey])
  @@index([ownerId, status, nextTouchAt])
  @@map("leads")
}

model Touch {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  leadId         String        @map("lead_id")
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId         String?       @map("deal_id")
  deal           Deal?         @relation(fields: [dealId], references: [id])
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id])
  channel        Channel
  step           Int
  outcome        TouchOutcome
  reason         String?       @db.Text
  body           String?       @db.Text
  externalRef    String?       @map("external_ref")
  sessionId      String?       @map("session_id")
  session        FocusSession? @relation(fields: [sessionId], references: [id])
  occurredAt     DateTime      @map("occurred_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("touches")
}

model FocusSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        Channel
  lengthMinutes  Int       @map("length_minutes")
  goal           Json      @default("{}")
  touchCount     Int       @default(0) @map("touch_count")
  conversationCount Int    @default(0) @map("conversation_count")
  summary        String?   @db.Text
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")

  touches Touch[]

  @@map("focus_sessions")
}

model Reply {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  leadId         String      @map("lead_id")
  lead           Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel        Channel
  text           String      @db.Text
  label          ReplyLabel?
  status         ReplyStatus @default(open)
  responseDraft  String?     @map("response_draft") @db.Text
  receivedAt     DateTime    @default(now()) @map("received_at")
  handledAt      DateTime?   @map("handled_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("replies")
}

model ObjectionResponse {
  id              String                   @id @default(uuid())
  organizationId  String                   @map("organization_id")
  campaignId      String                   @map("campaign_id")
  campaign        Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  objection       String                   @db.Text
  responseText    String                   @map("response_text") @db.Text
  uses            Int                      @default(0)
  keptTalkingCount Int                     @default(0) @map("kept_talking_count")
  lostCount       Int                      @default(0) @map("lost_count")
  status          ObjectionResponseStatus  @default(new)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("objection_responses")
}

model Deal {
  id               String      @id @default(uuid())
  organizationId   String      @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId           String      @map("lead_id")
  lead             Lead        @relation(fields: [leadId], references: [id])
  ownerId          String      @map("owner_id")
  owner            User        @relation("DealOwner", fields: [ownerId], references: [id])
  productId        String      @map("product_id")
  product          Product     @relation(fields: [productId], references: [id])
  campaignId       String      @map("campaign_id")
  campaign         Campaign    @relation(fields: [campaignId], references: [id])
  stage            DealStage   @default(interested)
  stageChangedAt   DateTime    @default(now()) @map("stage_changed_at")
  checklist        Json        @default("{}")
  nextStepText     String?     @map("next_step_text") @db.Text
  nextStepAt       DateTime?   @map("next_step_at")
  health           Int         @default(60)
  signals          Json        @default("{}")
  nextBestAction   String?     @map("next_best_action") @db.Text
  valueMonthlyUsd  Decimal?    @map("value_monthly_usd") @db.Decimal(10, 2)
  lostReason       LostReason? @map("lost_reason")
  wonAt            DateTime?   @map("won_at")
  lostAt           DateTime?   @map("lost_at")
  isDemo           Boolean     @default(false) @map("is_demo")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  people        DealPerson[]
  touches       Touch[]
  conversations Conversation[]

  @@index([ownerId, stage])
  @@map("deals")
}

model DealPerson {
  id              String  @id @default(uuid())
  dealId          String  @map("deal_id")
  deal            Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name            String
  role            String?
  email           String?
  phone           String?
  isDecisionMaker Boolean @default(false) @map("is_decision_maker")
  met             Boolean @default(false)

  @@map("deal_people")
}

model Conversation {
  id                String             @id @default(uuid())
  organizationId    String             @map("organization_id")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId            String?            @map("deal_id")
  deal              Deal?              @relation(fields: [dealId], references: [id])
  leadId            String?            @map("lead_id")
  lead              Lead?              @relation(fields: [leadId], references: [id])
  kind              ConversationKind
  title             String             @db.VarChar(500)
  body              String             @db.Text
  source            ConversationSource @default(manual)
  audioPath         String?            @map("audio_path") @db.VarChar(2048)
  consentConfirmed  Boolean            @default(false) @map("consent_confirmed")
  occurredAt        DateTime           @map("occurred_at")
  reviewStatus      ReviewStatus       @default(none) @map("review_status")
  createdAt         DateTime           @default(now()) @map("created_at")

  review Review?

  @@map("conversations")
}

model Review {
  id              String      @id @default(uuid())
  conversationId  String      @unique @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  score           Int
  verdict         String      @db.Text
  wentWell        Json        @default("[]") @map("went_well")
  mistakes        Json        @default("[]")
  missed          Json        @default("[]")
  tags            Json        @default("[]")
  checksMet       Json        @default("[]") @map("checks_met")
  suggestedStage  String?     @map("suggested_stage")
  nextBestAction  String?     @map("next_best_action") @db.Text
  suggestedMessage String?    @map("suggested_message") @db.Text
  signals         Json        @default("{}")
  model           String?
  promptVersion   String?     @map("prompt_version")
  isBasic         Boolean     @default(true) @map("is_basic")
  repFeedback     RepFeedback? @map("rep_feedback")
  repFeedbackById String?     @map("rep_feedback_by")
  repFeedbackBy   User?       @relation("ReviewFeedbackBy", fields: [repFeedbackById], references: [id])
  repFeedbackNote String?     @map("rep_feedback_note") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("reviews")
}

model CoachingRule {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart      DateTime           @map("week_start") @db.Date
  tag            String
  ruleText       String             @map("rule_text") @db.Text
  createdById    String?            @map("created_by")
  status         CoachingRuleStatus @default(active)
  resultNote     String?            @map("result_note") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")

  @@map("coaching_rules")
}

model ChatThread {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")

  messages ChatMessage[]

  @@unique([userId, date])
  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String     @map("thread_id")
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String     @db.Text
  context   Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("chat_messages")
}

model Integration {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?             @map("user_id")
  user           User?               @relation(fields: [userId], references: [id])
  provider       IntegrationProvider
  status         String              @default("disconnected")
  scopes         Json     @default("[]")
  encryptedTokens String?            @map("encrypted_tokens") @db.Text
  lastSyncAt     DateTime?           @map("last_sync_at")
  lastError      String?             @map("last_error") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("integrations")
}

model AiUsage {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @map("user_id")
  user           User?        @relation(fields: [userId], references: [id])
  feature        AiFeature
  model          String
  inputTokens    Int          @default(0) @map("input_tokens")
  outputTokens   Int          @default(0) @map("output_tokens")
  costUsd        Decimal      @default(0) @map("cost_usd") @db.Decimal(10, 4)
  latencyMs      Int          @default(0) @map("latency_ms")
  success        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("ai_usage")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?      @map("actor_id")
  actor          User?        @relation(fields: [actorId], references: [id])
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?      @map("user_agent") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

model Notification {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String              @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  body           String              @db.Text
  link           String?             @db.VarChar(2048)
  readAt         DateTime?           @map("read_at")
  channel        NotificationChannel @default(in_app)
  createdAt      DateTime            @default(now()) @map("created_at")

  @@map("notifications")
}
