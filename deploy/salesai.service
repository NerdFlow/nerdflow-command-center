[Unit]
Description=NerdFlow Sales Command Center
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/products/salesAI
Environment=NODE_ENV=production
EnvironmentFile=/var/www/products/salesAI/.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3010
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
